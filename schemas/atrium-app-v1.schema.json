{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TheBigTreeInc/atrium/blob/main/schemas/atrium-app-v1.schema.json",
  "title": "Atrium reviewed application manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "version",
    "publisher",
    "kind",
    "entry",
    "sha256"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{2,119}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "maxLength": 48
    },
    "publisher": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,119}$"
    },
    "kind": {
      "enum": [
        "game",
        "social",
        "utility",
        "application"
      ]
    },
    "entry": {
      "type": "string",
      "format": "uri",
      "maxLength": 512
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 12,
      "items": {
        "enum": [
          "profile:read",
          "game:join",
          "notifications:read"
        ]
      }
    }
  }
}
