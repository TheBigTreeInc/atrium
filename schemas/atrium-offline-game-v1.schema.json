{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Atrium source-only offline web game candidate v1",
  "description": "Candidate interchange for external game builds. It is NOT a TaviX manifest or an installed-game registry protocol.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "publisher", "title", "version", "entry", "runtime", "offline", "files"],
  "properties": {
    "schema": {"const": "atrium.offline-game/v1"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{2,119}$"},
    "publisher": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,119}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 160},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "entry": {"const": "index.html"},
    "runtime": {"const": "tavix-web-candidate"},
    "offline": {"const": true},
    "files": {
      "type": "object", "minProperties": 1, "maxProperties": 256,
      "required": ["index.html"],
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
      "propertyNames": {"pattern": "^[a-zA-Z0-9_][a-zA-Z0-9_./-]*$"}
    }
  }
}
