{
  "schema": "ziprunner.zr/v1",
  "project_key": "atrium",
  "label": "Atrium — unified games and app registry (Looprd/DAPI)",
  "match": [
    "atrium-*-ziprunner.zip"
  ],
  "command_subdir": ".",
  "stop": [],
  "stop_ports": [],
  "build": [
    "python tools/setup_build_env.py",
    "python tools/run_python_checks.py",
    "npm test",
    "npm run build",
    "npm run verify"
  ],
  "start": [],
  "build_window": "hidden",
  "start_window": "managed",
  "delete_missing": false,
  "strip_single_root": false,
  "protected_paths": [
    ".git/**",
    ".env",
    ".env.*",
    "*.sqlite",
    "*.sqlite3",
    "*.local.json",
    "data/**",
    "logs/**",
    "state/**",
    "secrets/**",
    "node_modules/**",
    "dist/**",
    "ziprunner.config.json",
    "ziprunner.project-state.json",
    "*.pem",
    "*.key",
    "*.crt",
    "*.pfx",
    "private/**",
    "server-state/**",
    "runtime/**",
    "uploads/**",
    "packages/**",
    "public-index/**",
    "chrome-profile/**",
    "target/**",
    "build/**",
    ".venv/**",
    ".venv/"
  ],
  "require_clean_git_before_overlay": false,
  "mechanisms_require_build_success": true,
  "post_build_mechanisms": []
}
