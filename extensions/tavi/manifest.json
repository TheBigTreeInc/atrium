{
  "schema": "tavi.extension/v1",
  "id": "inc.thebigtree.tavi.atrium",
  "version": "1.0.4",
  "name": "Atrium",
  "summary": "Browse approved social games and resume through their own authorized services. Tavi stays your messenger.",
  "publisher": "thebigtreeinc",
  "kind": "app",
  "hostApi": {
    "min": "1.0.0",
    "maxExclusive": "2.0.0"
  },
  "entrypoints": {
    "panel": "ui/index.html"
  },
  "contributions": [
    {
      "slot": "app.launcher",
      "id": "games",
      "label": "Atrium Games",
      "action": "openPanel"
    }
  ],
  "permissions": [
    "ui.panel"
  ],
  "platforms": [
    "web",
    "windows",
    "android"
  ]
}
